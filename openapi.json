          "score": {
            "description": "Plan economic quality score (1 to 10)",
            "maximum": 10,
            "minimum": 1,
            "title": "Score",
            "type": "integer"
          },
          "reason": {
            "description": "Plain-English explanation of decision",
            "minLength": 5,
            "title": "Reason",
            "type": "string"
          }
        },
        "required": [
          "approve",
          "score",
          "reason"
        ],
        "title": "LLMVetoDecision",
        "type": "object"
