{
  "openapi": "3.1.0",
  "info": {
    "title": "GivEnergy Tariff Optimiser \u2014 Data Contracts & Schemas",
    "version": "1.0.22.4",
    "description": "Auto-generated OpenAPI specification from Pydantic v2 data models. Single source of truth for inverter telemetry, Octopus tariffs, GivTCP REST payloads, and ChatGPT AI veto validation."
  },
  "components": {
    "schemas": {
      "GivTCPWriteSlot": {
        "description": "Payload contract for POST /setChargeSlot on GivTCP API.",
        "properties": {
          "start": {
            "description": "Start time in HH:MM format",
            "example": "02:30",
            "title": "Start",
            "type": "string"
          },
          "finish": {
            "description": "Finish time in HH:MM format",
            "example": "04:00",
            "title": "Finish",
            "type": "string"
          },
          "slot": {
            "description": "Slot index string ('1' to '10')",
            "example": "1",
            "title": "Slot",
            "type": "string"
          },
          "chargeToPercent": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Target charge percentage (1-100)",
            "example": 100,
            "title": "Chargetopercent"
          }
        },
        "required": [
          "start",
          "finish",
          "slot"
        ],
        "title": "GivTCPWriteSlot",
        "type": "object"
      },
      "GivTCPTarget": {
        "description": "Payload contract for POST /setChargeTarget on GivTCP API.",
        "properties": {
          "chargeToPercent": {
            "description": "Battery target SoC %",
            "example": 100,
            "maximum": 100,
            "minimum": 0,
            "title": "Chargetopercent",
            "type": "integer"
          }
        },
        "required": [
          "chargeToPercent"
        ],
        "title": "GivTCPTarget",
        "type": "object"
      },
      "GivTCPBatteryMode": {
        "description": "Payload contract for POST /setBatteryMode on GivTCP API.",
        "properties": {
          "mode": {
            "description": "Inverter battery mode: 'Timed Demand' or 'Eco'",
            "example": "Timed Demand",
            "title": "Mode",
            "type": "string"
          }
        },
        "required": [
          "mode"
        ],
        "title": "GivTCPBatteryMode",
        "type": "object"
      },
      "InverterTelemetry": {
        "description": "Inverter live telemetry contract parsed from GivTCP GET /getCache.",
        "properties": {
          "soc": {
            "description": "Battery state of charge %",
