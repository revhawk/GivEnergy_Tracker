          "soc",
          "pv_power",
          "load_power"
        ],
        "title": "InverterTelemetry",
        "type": "object"
      },
      "OctopusRateSlot": {
        "description": "Octopus Agile import or Outgoing export half-hour rate contract.",
        "properties": {
          "valid_from": {
            "description": "Slot start time in ISO 8601 UTC format",
            "title": "Valid From",
            "type": "string"
          },
          "valid_to": {
            "description": "Slot end time in ISO 8601 UTC format",
            "title": "Valid To",
            "type": "string"
